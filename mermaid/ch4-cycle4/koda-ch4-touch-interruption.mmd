%% Cycle 4 - Flot d'interruption par capteur tactile (chatouilles)
%% Export -> public/koda-cycle4-touch-interruption.png

flowchart LR
    classDef step fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
    classDef wait fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c
    classDef act fill:#fff3e0,stroke:#ef6c00,color:#bf360c
    classDef ok fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20

    LOOP["boucle robot<br/>_run_robot_loop_with_touch"]
    WAIT["asyncio.wait FIRST_COMPLETED<br/>behavior / touch / stop"]
    INTR["_handle_touch_interrupt"]
    STOP_OK(["arret propre"])
    BEH_OK(["fin de tour"])

    LOOP --> WAIT
    WAIT -- "touch_event.set" --> INTR
    WAIT -- "stop_event.set" --> STOP_OK
    WAIT -- "behavior done" --> BEH_OK

    INTR --> C1["motion.request_abort"]
    C1 --> C2["behavior_task.cancel"]
    C2 --> C3["audio_output.stop_playback"]
    C3 --> C4["motion.stop S"]
    C4 --> C5["kill_tracked_subprocesses<br/>grace 250 ms"]
    C5 --> C6["display.set_expression HAPPY"]
    C6 --> C7["play laugh WAV / speech"]
    C7 --> C8["display.resume_idle"]
    C8 --> NEXT["recreate behavior_task"]
    NEXT --> LOOP

    class LOOP,WAIT,NEXT step
    class INTR,C1,C2,C3,C4,C5,C6,C7,C8 act
    class STOP_OK,BEH_OK ok
